// Cloudflare Workers config for bee747.com.
// One Worker: static site from ./public plus the /api/apiary endpoint in src/worker.js.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bee747",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // The site. Every request runs through the Worker first (so the www -> apex
  // redirect applies to pages and images too); anything not /api/* is then
  // served from ./public via env.ASSETS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Live-panel storage. Create once with:  npx wrangler kv namespace create LIVE
  // then paste the id it prints here (the preview_id is for `wrangler dev --remote`).
  "kv_namespaces": [
    { "binding": "LIVE", "id": "19c9df0056a64f19bc5f4683798b9614" }
  ],

  // The Pi's publish token is a secret, never in this file:
  //   npx wrangler secret put PUBLISH_TOKEN
  // For local `wrangler dev`, put it in .dev.vars (git-ignored).

  "routes": [
    { "pattern": "bee747.com", "custom_domain": true },
    { "pattern": "www.bee747.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
